# RBHU Enterprise Operations Platform - Backend Environment Configuration

PORT=5000
NODE_ENV=development

# Database Configuration
# Local SQLite Dev fallback:
DATABASE_URL="file:./dev.db"
# Azure Database for PostgreSQL (Production / Staging):
# DATABASE_URL="postgresql://rbhuadmin:YourStrongPassword@rbhu-postgres-server.postgres.database.azure.com:5432/rbhudb?sslmode=require"

# JWT Authentication
JWT_SECRET="rbhu_super_secret_jwt_key_2026_enterprise_production_grade"
JWT_EXPIRES_IN="1d"

# Allowed CORS Origins (comma separated)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Microservices
ANALYTICS_SERVICE_URL="http://127.0.0.1:5001"

# AI Assistant (OpenAI or Azure OpenAI - optional; automated fallback mode activates if empty)
OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_KEY=""
AZURE_OPENAI_DEPLOYMENT_NAME=""
